{
  "name": "geckoengage-mcp",
  "version": "0.1.0",
  "description": "MCP server for Gecko Engage: lets Claude, ChatGPT and other MCP clients read events, attendances, forms, form responses, contacts, labels and campaigns from a Gecko student recruitment CRM, and (when enabled) register a contact for an event or add a label to a contact.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node test/e2e.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "geckoengage",
    "claude",
    "student-recruitment"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "bin": {
    "geckoengage-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
